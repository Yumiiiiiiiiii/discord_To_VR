{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord to VR",
  "version": "0.2.0",
  "identifier": "io.github.yumiiiiiiiiii.discord-to-vr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Discord → VR",
        "width": 1120,
        "height": 900,
        "minWidth": 820,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Discord to VR",
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["Japanese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5OERDNjFDNTZGOUFBRkQKUldUOXF2bFdITWFOaVVjWHBLdC9xNUFCclNoOEl4QVJaZkQxT3M1Y1k3b3Q3aEtqcVkvUXBscEkK",
      "endpoints": ["https://github.com/Yumiiiiiiiiii/discord_To_VR/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
